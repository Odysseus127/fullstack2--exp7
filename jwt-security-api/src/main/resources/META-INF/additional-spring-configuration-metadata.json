{
  "properties": [
    {
      "name": "security.jwt.secret-base64",
      "type": "java.lang.String",
      "description": "Base64-encoded JWT signing key."
    },
    {
      "name": "security.jwt.access-token-ttl",
      "type": "java.time.Duration",
